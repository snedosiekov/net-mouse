#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/ui/win/resource_ids.h"

// The first icon is also the .exe icon shown in Explorer.
IDI_APP    ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/ui/win/res/app.ico"
IDI_ACTIVE ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/ui/win/res/active.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Net Mouse - share one mouse between PCs"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "Net Mouse"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "net-mouse.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
