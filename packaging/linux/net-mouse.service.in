[Unit]
Description=Net Mouse - share one mouse between PCs
Documentation=https://github.com/snedosiekov/net-mouse
After=network-online.target systemd-udev-settle.service
Wants=network-online.target
# Never give up restarting (e.g. the network is not up yet at boot).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe uinput
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/net-mouse-daemon --config /etc/net-mouse/netmouse.ini
# Also used to apply role/monitor changes: the daemon exits and is started again.
Restart=always
RestartSec=2
# Control socket for net-mouse-gui and net-mouse-ctl: /run/net-mouse/control.sock
RuntimeDirectory=net-mouse
RuntimeDirectoryMode=0755

# Needs root for /dev/uinput and exclusive access to /dev/input/event*; everything else is locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/net-mouse
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
